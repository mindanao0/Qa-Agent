# ── Ollama / LLM ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
EMBEDDING_MODEL=nomic-embed-text

# ── Target Application ────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3000

# ── RBAC Credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

HR_MANAGER_USERNAME=hr_manager
HR_MANAGER_PASSWORD=changeme

PAYROLL_USERNAME=payroll_officer
PAYROLL_PASSWORD=changeme

EMPLOYEE_USERNAME=employee
EMPLOYEE_PASSWORD=changeme

AUDITOR_USERNAME=auditor
AUDITOR_PASSWORD=changeme

# ── Storage Paths ─────────────────────────────────────────────────────────────
QA_AGENT_HOME=~/.qa-agent
VECTOR_DB_PATH=~/.qa-agent/vector_db
SESSIONS_DIR=~/.qa-agent/sessions
DATASETS_DIR=~/.qa-agent/datasets
CHECKPOINTS_DIR=~/.qa-agent/checkpoints
AUTH_STORAGE_DIR=~/.qa-agent/auth

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=~/.qa-agent/qa-agent.log

# ── Allure Reporting ──────────────────────────────────────────────────────────
ALLURE_RESULTS_DIR=allure-results

# ── Fine-tuning (optional) ────────────────────────────────────────────────────
HF_TOKEN=
WANDB_API_KEY=
WANDB_PROJECT=qa-agent-finetune
