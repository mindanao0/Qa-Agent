# Training data (not committed — use data/training/.gitkeep to track the directory)
data/training/*.jsonl
data/training/*.json
!data/training/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
dist/
build/
*.egg-info/

# Node
node_modules/

# Pytest / Hypothesis
.pytest_cache/
.hypothesis/

# Logs
logs/

# Model artefacts — multi-GB, never commit (models/.gitkeep marks the dir;
# includes finetune_output checkpoints/logs and every exported GGUF)
models/*
!models/.gitkeep
unsloth_compiled_cache/

# QA reports — raw run dumps are huge and rewritten every run; commit only
# small curated summaries
reports/qa_report_*.html
reports/screenshots/
reports/multi_site/_*.txt
reports/multi_site/detail/

# Continuous mode (python -m src.continuous) — per-run checkpoint db / SFG store /
# episodic memory / crypto audit trail, one directory per --run-id; never commit
# (contrast with the frozen, committed audit/sprint11/ gate proof)
reports/continuous/

# Dedupe backup of the training set
data/training/*.jsonl.bak

# Claude Code local state — per-user/per-session, churns every run
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Misc
package-lock.json
audit/wddm_backup.reg

# Test credentials — NEVER commit passwords (use eval/test_credentials.example.json as template)
eval/test_credentials.json
